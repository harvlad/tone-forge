# syntax=docker/dockerfile:1.6
#
# Prebuilt RunPod analysis-worker image. Bakes the SLOW parts of the cold boot
# — system codecs, the Python analysis stack, and the model weights — so a
# freshly-spun pod skips the ~2-3 min bootstrap and is claiming jobs in seconds.
#
# The app CODE is NOT baked: it's bind-mounted at build time only (to install
# deps + prefetch models) and never copied into the final image. The running
# pod git-pulls the latest code via scripts/runpod_analysis_worker.sh — so the
# image doesn't need rebuilding on every code change (only on dep/model
# changes) AND it carries no private source, so the GHCR package can be public
# and RunPod needs no registry auth to pull it.
#
# RUNTIME (not devel) base: torch/demucs/torchcrepe ship prebuilt CUDA kernels,
# so the ~7 GB CUDA toolkit/compilers in a -devel image are dead weight at
# runtime. The runpod/pytorch:...-devel image was ~12 GB and took 7+ min to pull
# on a fresh host (job stranded at "waiting for the analysis engine"). This
# cuda12.4-cudnn9-runtime base is ~3 GB. CUDA 12.4 runtime runs on any host
# driver >= 12.4 (the 12.8.1 image lost the GPU on 12.8.0-driver hosts).
FROM pytorch/pytorch:2.4.1-cuda12.4-cudnn9-runtime

# HARD pin of the torch stack for every pip step in this build AND at
# runtime (ENV persists into the pod, so the bootstrap inherits it).
# Without this, requirements resolution upgraded torch to a CUDA-13
# build inside the image (observed 2026-09-07: torch 2.14+cu130 baked
# into the "cuda12.4" image) — cu13 wheels need newer host drivers
# than many RunPod hosts run (the intermittent torch.cuda-unavailable
# lottery) and mismatch the CUDA-12 onnxruntime-gpu, whose CUDA
# provider then silently falls back to CPU. If a dep genuinely needs a
# newer torch, this build FAILS loudly instead of shipping a mismatch.
RUN printf 'torch==2.4.1\ntorchaudio==2.4.1\n' > /opt/jamn-pip-constraints.txt
ENV PIP_CONSTRAINT=/opt/jamn-pip-constraints.txt

# System codecs the analysis stack needs but the base image lacks: ffmpeg
# decodes m4a/mp3 (_ensure_decodable); libsndfile backs soundfile.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libsndfile1 git \
    && rm -rf /var/lib/apt/lists/*

# Install the analysis deps + prefetch models using a BUILD-ONLY bind mount of
# the repo (target=/src exists only during this RUN — nothing is copied into a
# layer), so no source lands in the published image. torch/torchaudio already
# ship in the base; requirements.txt fills the rest. download_models warms the
# Demucs + Beat-This + All-In-One caches under /root/.cache, which persist.
RUN --mount=type=bind,target=/src \
    cd /src/backend \
    && python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && PYTHONPATH=. python -m local_engine.download_models || echo "WARN: model prefetch partial"

# basic-pitch + onnxruntime-GPU baked in: the polyphonic basic_pitch pass is
# the heaviest MIDI stage (~10 min/song on guitar+other with the CPU ORT
# build), and this is a CUDA image — ORT-GPU selects the CUDA execution
# provider automatically. basic-pitch deliberately WITHOUT the [onnx] extra
# so it can't pin the CPU onnxruntime back in. The bootstrap script repeats
# this conditionally for unbaked-image pods.
RUN python -m pip uninstall -y onnxruntime tensorflow 2>/dev/null; \
    python -m pip install --no-cache-dir --no-deps basic-pitch \
    && python -m pip install --no-cache-dir mir_eval resampy onnxruntime-gpu

# Runtime: pull the latest code, then run the claim-loop bootstrap. On this
# image its apt/pip/download steps are already satisfied, so it's git-pull-fast.
ENV JAMN_REPO_DIR=/workspace/tone-forge
CMD ["bash", "-lc", "cd /workspace/tone-forge 2>/dev/null || git clone \"$JAMN_REPO_URL\" /workspace/tone-forge; bash /workspace/tone-forge/backend/scripts/runpod_analysis_worker.sh"]
