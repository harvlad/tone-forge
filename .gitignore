# mobile-ios golden/input test fixtures are tracked despite the
# repo-wide *.wav rule above.
!mobile-ios/Tests/ToneForgeMobileTests/Fixtures/*.wav

# ToneForge runtime artifacts
backend/benchmark_results/
backend/profile_results/
backend/preset_catalog_output/
backend/data/tone_log.jsonl
backend/data/history.json
# layer uploads posted by the mobile app at runtime
backend/data/layers/

# bench/ harness outputs (M1)
backend/bench/runs/

# song-form scratch artifacts — generated per-song JSON/PNG outputs.
# The runner scripts (run_feasibility.py, run_discovery.py) and any
# manually-curated .md notes are tracked; the regenerated data isn't.
backend/song_form_feasibility/*
!backend/song_form_feasibility/*.py
!backend/song_form_feasibility/*.md
backend/song_form_phase0c/*
!backend/song_form_phase0c/*.py
!backend/song_form_phase0c/*.md
backend/song_form_signal_discovery/*
!backend/song_form_signal_discovery/*.py
!backend/song_form_signal_discovery/*.md

# history.json point-in-time backups (created by data-migration scripts).
backend/data/history.json.bak.*

# Node (frontend)
node_modules/
.next/
out/
.nuxt/
dist/

# Environment
.env
.env.local
.env.*.local

# Benchmark ground-truth datasets (large, licensed separately)
backend/bench/data/

# Local admin tokens (secrets — never commit)
backend/.admin_token
backend/.jamn_admin_token

# Transcription-lab / specialist-discovery local artifacts (large, regenerable
# or mirrored on the volume per the artifact-durability rule)
.hf_cache/
.mt3_checkpoints/
backend/.mt3_checkpoints/
backend/experiments/basic_pitch_finetune/
backend/lab_data/derived/
backend/data/performance_cache/
backend/models/
backend/pas.json
datasets/
samples/
*.profraw

# handrig optimizer-benchmark GIFs (report JSON is tracked; GIFs are heavy demos)
tools/handrig/benchmark/results/*.gif

# one-off data-ops scratch scripts
scratchpad_cambridge218_to_r2.sh
